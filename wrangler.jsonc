{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-recall",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  // `assets.directory` は指定しない。@cloudflare/vite-plugin がビルド出力を自動で結線する。
  "assets": {
    "not_found_handling": "single-page-application",
    // OAuth のコールバックは fetch ではなくトップレベルのページ遷移なので、
    // SPA フォールバックに吸われて Worker まで届かない。/api/* を先に Worker へ流す。
    // これが無いと /api/auth/callback/google に index.html が返り、認証が完了しない。
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-recall-db",
      // ローカル開発用のプレースホルダ。リモート D1 を作成したら差し替える。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // ここに "vars" は置かない。
  // 開発用モックログインのフラグ ALLOW_DEV_LOGIN は .dev.vars（git 管理外）にだけ書く。
  // このファイルは Workers Builds が本番ビルドでもそのまま使うため、ここに "true" を置くと
  // 本番にモックログインが漏れる。未定義なら worker 側の `=== 'true'` が偽になり自動的に無効。
  // ("false" と書かない理由: wrangler types が vars をリテラル型で吐くため、
  //  `env.ALLOW_DEV_LOGIN === 'true'` が「重ならない型の比較」で型エラーになる)
  "observability": {
    "enabled": true
  }
}
